# Required only for enhanced mode. Keep this in Netlify's function environment;
# never rename it to VITE_OPENROUTER_API_KEY or place it in browser code.
OPENROUTER_API_KEY=

# Pinned, verified OpenRouter defaults. Override only for deliberate upgrades.
OPENROUTER_JEV_MODEL=typesafe/jev-1.14
OPENROUTER_REPORT_MODEL=deepseek/deepseek-v4.1-flash-1017

# Optional when the site uses an additional custom origin.
# ENI_TRACE_ALLOWED_ORIGIN=https://trace.example.com
